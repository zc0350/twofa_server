APP_DEBUG=true

DEFAULT_TIMEZONE=Asia/Shanghai

# ---- 数据库配置（修改为实际值）----
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=twofa
DB_USER=twofa
DB_PASS=

# ---- SMTP 邮箱配置（注册验证码发送，必填）----
# SMTP 服务器地址，如 smtp.qq.com / smtp.exmail.qq.com / smtp.163.com
SMTP_HOST=
# 端口：SSL 通常 465，TLS 通常 587
SMTP_PORT=465
# 加密方式：ssl 或 tls
SMTP_SECURE=ssl
# 发件账号
SMTP_USER=
# 发件密码或授权码（QQ 邮箱为 16 位授权码，非登录密码）
SMTP_PASS=
# 发件地址（默认同 SMTP_USER，部分服务商要求一致）
SMTP_FROM=
# 发件人显示名称
SMTP_FROM_NAME=2FA 验证器
